<Window x:Class="Lab1_IvanovAV_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Лабораторная работа №1 — Фигуры"
        Width="760" Height="820" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            CornerRadius="10" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Лабораторная работа №1 — Фигуры"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               FontSize="13" Foreground="{DynamicResource TextBrush}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click" ToolTip="Свернуть">
                            <Rectangle Width="10" Height="1" Fill="{DynamicResource TextBrush}"/>
                        </Button>

                        <Button Click="MaximizeButton_Click" ToolTip="Развернуть">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Rectangle Width="10" Height="10" Fill="Transparent"
                                       Stroke="{DynamicResource TextBrush}" StrokeThickness="1"/>
                        </Button>

                        <Button Click="MaximizeButton_Click" ToolTip="Восстановить размер">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Width="14" Height="14">
                                <Path Data="M 4,4 V 1 H 12 V 9 H 10"
                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"/>
                                <Path Data="M 1.5,4.5 H 9.5 V 12.5 H 1.5 Z"
                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"
                                      Fill="{DynamicResource TitleBarBrush}"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource CloseButtonStyle}"
                                Click="CloseButton_Click" ToolTip="Закрыть">
                            <Path Width="12" Height="12" Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.3" Stretch="Fill"
                                  Data="M 0 0 L 12 12 M 12 0 L 0 12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel Margin="20">
                    <TextBlock Text="Расчёт фигур" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Введите размеры фигуры и выполните расчёт"
                               FontSize="14" Margin="0,4,0,16"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,12" IsHitTestVisible="False"/>
                        <Border Grid.Row="4" Grid.RowSpan="4" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,12" IsHitTestVisible="False"/>
                        <Border Grid.Row="8" Grid.RowSpan="4" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,12" IsHitTestVisible="False"/>
                        <Border Grid.Row="12" Grid.RowSpan="3" Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="10" IsHitTestVisible="False"/>

                        <Label Grid.Row="0" Content="Эллипс" FontWeight="Bold" FontSize="16"
                               Margin="16,14,12,5"/>
                        <Grid Grid.Row="1" Margin="16,0,16,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Полуось a"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="EllipseMajorTextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="EllipseMajorTextBox_TextChanged"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Полуось b"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EllipseMinorTextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="EllipseMinorTextBox_TextChanged"/>
                        </Grid>
                        <Button Grid.Row="2" Content="Вычислить площадь и периметр"
                                Click="CalculateEllipse_Click" HorizontalAlignment="Left"
                                Margin="20,5,16,8"/>
                        <TextBlock Grid.Row="3" x:Name="EllipseResult"
                                   Margin="20,5,16,24" MinHeight="22" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <Label Grid.Row="4" Content="Квадрат" FontWeight="Bold" FontSize="16"
                               Margin="16,14,12,5"/>
                        <Grid Grid.Row="5" Margin="16,0,16,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Сторона"/>
                            <TextBox Grid.Column="1" x:Name="SquareSideTextBox" Width="200"
                                     Margin="5" HorizontalAlignment="Left"
                                     TextChanged="StoronaKvadrata_TextChanged"/>
                        </Grid>
                        <Button Grid.Row="6" Content="Вычислить площадь и периметр"
                                Click="CalculateSquare_Click" HorizontalAlignment="Left"
                                Margin="20,5,16,8"/>
                        <TextBlock Grid.Row="7" x:Name="SquareResult" MinHeight="22"
                                   Margin="20,5,16,24" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <Label Grid.Row="8" Content="Трапеция" FontWeight="Bold" FontSize="16"
                               Margin="16,14,12,5"/>
                        <Grid Grid.Row="9" Margin="16,0,16,5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="Основание a"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TrapezoidBaseATextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="RazmeryTrapecii_TextChanged"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="Основание b"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TrapezoidBaseBTextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="RazmeryTrapecii_TextChanged"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="Боковая сторона c"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TrapezoidSideCTextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="RazmeryTrapecii_TextChanged"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="Боковая сторона d"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TrapezoidSideDTextBox"
                                     Width="200" Margin="5" HorizontalAlignment="Left"
                                     TextChanged="RazmeryTrapecii_TextChanged"/>
                        </Grid>
                        <StackPanel Grid.Row="10" Margin="16,0,16,0">
                            <TextBlock x:Name="TrapezoidConditionTextBox" Margin="5"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="Условие существования трапеции:"/>
                                <LineBreak/>
                                <Run Text="a, b — основания; c, d — боковые стороны."/>
                                <LineBreak/>
                                <Run Text="a, b, c, d &gt; 0; a ≠ b;"/>
                                <LineBreak/>
                                <Run Text="|c − d| &lt; |a − b| &lt; c + d"/>
                            </TextBlock>
                            <Button Content="Вычислить площадь и периметр"
                                    Click="CalculateTrapezoid_Click"
                                    HorizontalAlignment="Left" Margin="5,12,5,10"/>
                        </StackPanel>
                        <TextBlock Grid.Row="11" x:Name="TrapezoidResult" MinHeight="22"
                                   Margin="20,5,16,24" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <Label Grid.Row="12" Content="Демонстрация методов классов"
                               FontWeight="Bold" FontSize="16" Margin="16,14,12,5"/>
                        <Button Grid.Row="13" Content="Показать работу классов"
                                Click="DemonstrateMethods_Click" HorizontalAlignment="Left"
                                Margin="20,5,16,10"/>
                        <TextBox Grid.Row="14" x:Name="DemonstrationResult"
                                 Height="240" Margin="20,5,20,18" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
