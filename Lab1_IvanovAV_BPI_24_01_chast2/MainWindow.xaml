<Window x:Class="Lab1_IvanovAV_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1_IvanovAV_BPI_24_01"
        mc:Ignorable="d"
        Title="ПРОГРАММА"
        Width="760"
        Height="820"
        MinWidth="560"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  CanContentScroll="False">

        <StackPanel Margin="15"
                    MinWidth="900">

            <Label Content="Выберите фигуру"
                   FontWeight="Bold"
                   Margin="0,10,0,5"/>

            <WrapPanel Margin="5">

                <RadioButton x:Name="EllipseRadioButton"
                             Content="Эллипс"
                             GroupName="Figures"
                             Margin="5"
                             Checked="FigureRadioButton_Checked"/>

                <RadioButton x:Name="SquareRadioButton"
                             Content="Квадрат"
                             GroupName="Figures"
                             Margin="5"
                             Checked="FigureRadioButton_Checked"/>

                <RadioButton x:Name="TrapezoidRadioButton"
                             Content="Трапеция"
                             GroupName="Figures"
                             Margin="5"
                             Checked="FigureRadioButton_Checked"/>

            </WrapPanel>


            <StackPanel x:Name="EllipsePanel"
                        Visibility="Collapsed">

                <Label Content="Эллипс"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Полуось a"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             x:Name="EllipseMajorTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Content="Полуось b"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="EllipseMinorTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                </Grid>

                <WrapPanel Margin="0,5,0,0">

                    <Button Content="Вычислить площадь и периметр"
                            Click="CalculateEllipse_Click"
                            Margin="5"/>

                </WrapPanel>

                <TextBlock x:Name="EllipseResult"
                           Margin="5"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <StackPanel x:Name="SquarePanel"
                        Visibility="Collapsed">

                <Label Content="Квадрат"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Сторона"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             x:Name="SquareSideTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                </Grid>

                <WrapPanel Margin="0,5,0,0">

                    <Button Content="Вычислить площадь и периметр"
                            Click="CalculateSquare_Click"
                            Margin="5"/>

                </WrapPanel>

                <TextBlock x:Name="SquareResult"
                           Margin="5"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <StackPanel x:Name="TrapezoidPanel"
                        Visibility="Collapsed">

                <Label Content="Трапеция"
                       FontWeight="Bold"
                       Margin="0,10,0,5"/>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Основание a"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             x:Name="TrapezoidBaseATextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Content="Основание b"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             x:Name="TrapezoidBaseBTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                    <Label Grid.Row="2"
                           Grid.Column="0"
                           Content="Боковая сторона c"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             x:Name="TrapezoidSideCTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                    <Label Grid.Row="3"
                           Grid.Column="0"
                           Content="Боковая сторона d"
                           VerticalAlignment="Center"/>

                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             x:Name="TrapezoidSideDTextBox"
                             Width="200"
                             Margin="5"
                             HorizontalAlignment="Left"
                             PreviewTextInput="NumberTextBox_PreviewTextInput"
                             DataObject.Pasting="NumberTextBox_Pasting"/>

                </Grid>

                <TextBox x:Name="TrapezoidConditionTextBox"
                         Margin="5"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         Text="Условие существования трапеции:&#10;a, b — основания; c, d — боковые стороны.&#10;a, b, c, d &gt; 0; a ≠ b;&#10;|c − d| &lt; |a − b| &lt; c + d"
                         TextChanged="TrapezoidConditionTextBox_TextChanged"/>

                <WrapPanel Margin="0,5,0,0">

                    <Button Content="Вычислить площадь и периметр"
                            Click="CalculateTrapezoid_Click"
                            Margin="5"/>

                </WrapPanel>

                <TextBlock x:Name="TrapezoidResult"
                           Margin="5"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <Label Content="Демонстрация методов классов"
                   FontWeight="Bold"
                   Margin="0,15,0,5"/>

            <Button Content="Показать работу классов"
                    Click="DemonstrateMethods_Click"
                    HorizontalAlignment="Left"
                    Margin="5"/>

            <TextBox x:Name="DemonstrationResult"
                     Height="240"
                     Margin="5"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

        </StackPanel>

    </ScrollViewer>

</Window>